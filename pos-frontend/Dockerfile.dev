FROM node:20-alpine

# Install Angular CLI globally and curl for healthchecks
RUN apk add --no-cache curl \
    && npm install -g @angular/cli@17 --silent

# Create workspace directory
WORKDIR /workspace/pos-frontend

EXPOSE 4200

CMD ["sh", "-c", "npm install --silent && ng serve --host 0.0.0.0 --port 4200 --proxy-config proxy.conf.json"]
