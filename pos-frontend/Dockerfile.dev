FROM node:20-alpine

# Install Angular CLI globally
RUN npm install -g @angular/cli@17 --silent

# Install curl for healthchecks
RUN apk add --no-cache curl

# Create workspace directory
WORKDIR /workspace/pos-frontend

# Pre-install dependencies (optional — speeds up first start)
# COPY package*.json ./
# RUN npm install --silent

EXPOSE 4200

CMD ["tail", "-f", "/dev/null"]
